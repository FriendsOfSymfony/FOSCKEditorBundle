{% block ckeditor_widget %}
    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>

    {% if enable %}
        {{ block('_ckeditor_styles') }}
        {{ block('_ckeditor_javascript') }}
    {% endif %}
{% endblock %}

{% block ckeditor_styles %}
    {% if enable %}
        {{ block('_ckeditor_styles') }}
    {% endif %}
{% endblock %}

{% block _ckeditor_styles %}
    {% set formattedCssPath = ckeditor_css_path(css_path) %}

    {% if formattedCssPath is iterable %}
        {% for path in formattedCssPath %}
            <link rel="stylesheet" href="{{ path }}"/>
        {% endfor %}
    {% else %}
        <link rel="stylesheet" href="{{ formattedCssPath }}"/>
    {% endif %}
{% endblock %}

{% block ckeditor_javascript %}
    {% if enable %}
        {{ block('_ckeditor_javascript') }}
    {% endif %}
{% endblock %}

{% block _ckeditor_javascript %}
    {% if autoload %}
        <script type="text/javascript" src="{{ ckeditor_translation_path(base_path) }}" nonce="{{ csp_script_nonce() }}"></script>
        <script type="text/javascript" src="{{ ckeditor_js_path(js_path) }}" nonce="{{ csp_script_nonce() }}"></script>
    {% endif %}
    <style>
        {% if not powered_by %}
            .ck.ck-powered-by {
                display: none;
            }
        {% endif %}
        {% if resize %}
            .ck.ck-editor__editable {
                resize: block;
            }
        {% endif %}
        {{ ckeditor_size(config) }}
        {% if styles %}
            {% for selector, selectorValue in styles %}
                {% for ruleName, value in selectorValue %}
                    {{ selector }} {
                        {{ ruleName }}: {{ value }};
                    }
                {% endfor %}
            {% endfor %}
        {% endif %}
    </style>

{#    {% for plugin_name, plugin in plugins %}#}
{#        <script type="module" src="{{ plugin.path ~ plugin.filename }}" nonce="{{ csp_script_nonce() }}"></script>#}
{#    {% endfor %}#}

    <script type="text/javascript" nonce="{{ csp_script_nonce() }}">
        {{ ckeditor_widget(id, config, {
            license_key: license_key,
            plugins: plugins
        }) }}

        {% block ckeditor_widget_extra %}{% endblock ckeditor_widget_extra %}
    </script>
{% endblock %}
